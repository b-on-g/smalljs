$bog_smalljs_playground $mol_view
	tab \tree
	draft? \
	editor_hint \
	seed_tree \
	seed_ts \
	store_scope \
	attr *
		bog_smalljs_pg_tab <= tab
	sub /
		<= Editor_pane $mol_view
			sub /
				<= Tabs $mol_view
					sub /
						<= Tree_tab $mol_button_minor
							click? <=> show_tree? null
							sub / <= tree_tab_label @ \view.tree
						<= Ts_tab $mol_button_minor
							click? <=> show_ts? null
							sub / <= ts_tab_label @ \view.ts
				<= Editor $mol_textarea
					value? <=> draft?
					hint <= editor_hint
		<= Preview_pane $mol_view
			sub /
				<= Preview_label $mol_view
					sub / <= preview_label_text @ \Preview
				<= Preview $mol_view
					sub <= preview_content /
