#!/bin/sh
# Keep generated content in sync with the docs markdown.
#
# When a commit touches any content/**/*.md, the embedded registry
# (content/content.ts), llms.txt and the course lessons are regenerated by
# content/gen.cjs and re-staged, so production never serves stale docs.
#
# Enable once per clone:  git config core.hooksPath .githooks

changed=$( git diff --cached --name-only --diff-filter=ACM | grep -E '^content/.*\.md$' )
[ -z "$changed" ] && exit 0

echo "pre-commit: content markdown changed → regenerating (content/gen.cjs)"

if ! node content/gen.cjs; then
	echo "" >&2
	echo "pre-commit: content/gen.cjs failed — see the error above." >&2
	echo "Nothing was committed. Fix the docs source and commit again." >&2
	exit 1
fi

git add -- content/content.ts content/llms.txt lessons/lessons.ts
echo "pre-commit: re-staged content/content.ts, content/llms.txt, lessons/lessons.ts"
exit 0
