$bog_smalljs_versus $mol_view
	framework_title* \
	vs_text @ \vs
	row_partial_template @ \Ranked on {n} of {total} metrics
	auto /
		<= pick_sync null
	sub /
		<= Head $mol_view
			sub /
				<= Title $mol_view
					dom_name \h1
					sub /
						<= title_text @ \Compare frameworks
				<= Intro $mol_view
					sub /
						<= intro_text @ \Pick two frameworks and see where they differ. Every number carries the source it came from and the date it was measured, and the crash tests run live in your own browser.
		<= Picker $mol_view
			sub /
				<= Pick_a $mol_search
					hint @ \React…
					query? <=> query_a? \
					suggests <= suggests_a /
				<= Vs $mol_view
					sub /
						<= vs_text
				<= Pick_b $mol_search
					hint @ \Vue…
					query? <=> query_b? \
					suggests <= suggests_b /
		<= Popular $mol_view
			sub /
				<= Popular_title $mol_view
					dom_name \h2
					sub /
						<= popular_title @ \Popular comparisons
				<= Popular_list $mol_view
					sub <= popular_links /
		<= Top_apps $mol_view
			sub /
				<= Top_apps_title $mol_view
					dom_name \h2
					sub /
						<= top_apps_title @ \Best for apps
				<= Top_apps_note $mol_view
