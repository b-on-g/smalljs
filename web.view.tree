$bog_builderui_div $mol_view

$bog_theme_auto $mol_plugin
	themes <= themes_default /
	theme_light \$mol_theme_light
	theme_dark \$mol_theme_dark
	mode? \system
	mode_next? null
	theme_next? null
	theme_prev? null
	theme_set? null
	is_light_now false
	attr * mol_theme <= theme \

$mol_image $mol_view
	dom_name \img
	attr *any
		^
		src <= uri \
		title <= hint
		alt <= title \
		loading <= loading \lazy
		decoding <= decoding \async
		crossOrigin <= cors null
		width <= natural_width 0
		height <= natural_height 0
	event *any
		load? <=> load? null
	minimal_width 16
	minimal_height 16

$mol_link $mol_view
	uri \
	dom_name \a
	uri_off \
	uri_native null
	external false
	attr *
		^
		href <= uri_unsafe <= uri_toggle \
		title <= hint_safe <= hint \
		target <= target \_self
		download <= file_name \
		mol_link_current <= current false
		rel <= relation \
	sub /$mol_view_content
		<= title
	arg *
	event *
		^
		click? <=> click? <=> event_click? null

$mol_svg $mol_view
	dom_name \svg
	dom_name_space \http://www.w3.org/2000/svg
	font_size 16
	font_family \
	style_size *

$mol_svg_root $mol_svg
	dom_name \svg
	attr *
		^
		viewBox <= view_box \0 0 100 100
		preserveAspectRatio <= aspect \xMidYMid

$mol_svg_path $mol_svg
	dom_name \path
	attr *
		^
		d <= geometry \


$mol_icon $mol_svg_root
	view_box \0 0 24 24
	minimal_width 16
	minimal_height 16
	sub /
		<= Path $mol_svg_path
			geometry <= path \

$mol_icon_magnify $mol_icon path \M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z

$mol_speck $mol_view
	theme \$mol_theme_accent
	sub /
		<= value null

$mol_button $mol_view
	enabled true
	click? null
	event_click? null
	status? /
	event *
		^
		click? <=> activate? <=> event_activate? null
		dblclick? <=> clicks? null
		keydown? <=> key_press? <=> event_key_press? null
	attr *
		^
		disabled <= disabled false
		role \button
		tabindex <= tab_index 0
		title <= hint_safe <= hint \
	sub /$mol_view_content
		<= title
	Speck $mol_speck
		value <= error \

$mol_button_typed $mol_button
	minimal_height 40
	minimal_width 40

$mol_button_minor $mol_button_typed

$mol_icon_chevron $mol_icon path \M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z

$mol_icon_chevron_down $mol_icon path \M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z

$mol_ghost $mol_view
	Sub $mol_view

$mol_follower $mol_ghost
	Anchor $mol_view
	align /number
		-.5
		-.5
	offset /number
		0
		0
	style *
		^
		transform <= transform \

$mol_pop $mol_view
	showed? false
	align_vert \
	align_hor \
	align \bottom_center
	prefer \vert
	auto /
		<= bubble null
	sub /
		<= Anchor null
	sub_visible /
		<= Anchor
		<= Follower $mol_follower
			offset <= bubble_offset /number
				0
				1
			align <= bubble_align /number
				0
				0
			Anchor <= Anchor
			Sub <= Bubble $mol_pop_bubble
				content <= bubble_content /$mol_view_content
				height_max <= height_max 9999

$mol_pop_bubble $mol_view
	sub <= content /$mol_view_content
	style *
		^
		maxHeight <= height_max 9999
	attr *
		^
		tabindex 0
		popover \manual

$mol_scroll $mol_view
	scroll_top? 0
	scroll_left? 0
	attr *
		^
		tabindex <= tabindex -1
	event *
		^
		scroll? <=> event_scroll? null

$mol_check $mol_button_minor
	attr *
		^
		mol_check_checked <= checked? false
		aria-checked <= aria_checked \false
		role <= aria_role \checkbox
	sub /$mol_view_content
		<= Icon null
		<= label /
			<= Title $mol_view
				sub /
					<= title \

$mol_pick $mol_pop
	event *
		^
		keydown? <=> keydown? null
	Anchor <= Trigger $mol_check
		minimal_width 40
		minimal_height 40
		enabled <= trigger_enabled true
		checked? <=> showed?
		clicks? <=> clicks? null
		sub <= trigger_content /$mol_view_content
			<= title
		hint <= hint \

$mol_icon_hamburger $mol_icon path \M22 13C22 14.11 21.11 15 20 15H4C2.9 15 2 14.11 2 13S2.9 11 4 11H13L15.5 13L18 11H20C21.11 11 22 11.9 22 13M12 3C3 3 3 9 3 9H21C21 9 21 3 12 3M3 18C3 19.66 4.34 21 6 21H18C19.66 21 21 19.66 21 18V17H3V18Z

$mol_list $mol_view
	render_visible_only true
	render_over 0.1
	sub <= rows /$mol_view
		<= Gap_before $mol_view style * paddingTop <= gap_before 0
		<= Empty $mol_view
		<= Gap_after $mol_view style * paddingTop <= gap_after 0
	item_height_min* 1
	item_width_min* 1
	view_window_shift? 0
	view_window /
		0
		0

$mol_check_expand $mol_check
	Icon $mol_icon_chevron
	level 0
	style *
		^
		paddingLeft <= level_style \0px
	checked? <=> expanded? false
	enabled <= expandable false

$mol_expander $mol_list
	rows /
		<= Label $mol_view
			sub /
				<= Trigger $mol_check_expand
					checked? <=> expanded? false
					expandable <= expandable true
					label <= label /
						<= title
				<= Tools null
		<= Content $mol_list
			rows <= content /

$mol_icon_translate $mol_icon path \M12.87,15.07L10.33,12.56L10.36,12.53C12.1,10.59 13.34,8.36 14.07,6H17V4H10V2H8V4H1V6H12.17C11.5,7.92 10.44,9.75 9,11.35C8.07,10.32 7.3,9.19 6.69,8H4.69C5.42,9.63 6.42,11.17 7.67,12.56L2.58,17.58L4,19L9,14L12.11,17.11L12.87,15.07M18.5,10H16.5L12,22H14L15.12,19H19.87L21,22H23L18.5,10M15.88,17L17.5,12.67L19.12,17H15.88Z

$mol_icon_white_balance_sunny $mol_icon path \M3.55 19.09L4.96 20.5L6.76 18.71L5.34 17.29M12 6C8.69 6 6 8.69 6 12S8.69 18 12 18 18 15.31 18 12C18 8.68 15.31 6 12 6M20 13H23V11H20M17.24 18.71L19.04 20.5L20.45 19.09L18.66 17.29M20.45 5L19.04 3.6L17.24 5.39L18.66 6.81M13 1H11V4H13M6.76 5.39L4.96 3.6L3.55 5L5.34 6.81L6.76 5.39M1 13H4V11H1M13 20H11V23H13

$mol_icon_monitor $mol_icon path \M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z

$mol_icon_weather_night $mol_icon path \M17.75,4.09L15.22,6.03L16.13,9.09L13.5,7.28L10.87,9.09L11.78,6.03L9.25,4.09L12.44,4L13.5,1L14.56,4L17.75,4.09M21.25,11L19.61,12.25L20.2,14.23L18.5,13.06L16.8,14.23L17.39,12.25L15.75,11L17.81,10.95L18.5,9L19.19,10.95L21.25,11M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C7.79,7.9 8.75,10.87 10.95,13.06C13.14,15.26 16.1,16.22 18.97,15.95M17.33,17.97C14.5,17.81 11.7,16.64 9.53,14.5C7.36,12.31 6.2,9.5 6.04,6.68C3.23,9.82 3.34,14.64 6.35,17.66C9.37,20.67 14.19,20.78 17.33,17.97Z

$bog_theme_switch $mol_view
	theme_auto $bog_theme_auto
	sub /
		<= Light $mol_button_minor
			attr *
				^
				bog_theme_switch_active <= light_active false
			hint <= light_hint @ \Светлая
			click?event <=> set_light?event null
			sub /
				<= Light_icon $mol_icon_white_balance_sunny
		<= System $mol_button_minor
			attr *
				^
				bog_theme_switch_active <= system_active false
			hint <= system_hint @ \Как в системе
			click?event <=> set_system?event null
			sub /
				<= System_icon $mol_icon_monitor
		<= Dark $mol_button_minor
			attr *
				^
				bog_theme_switch_active <= dark_active false
			hint <= dark_hint @ \Тёмная
			click?event <=> set_dark?event null
			sub /
				<= Dark_icon $mol_icon_weather_night

$mol_icon_script $mol_icon path \M17.8,20C17.4,21.2 16.3,22 15,22H5C3.3,22 2,20.7 2,19V18H5L14.2,18C14.6,19.2 15.7,20 17,20H17.8M19,2H8C6.3,2 5,3.3 5,5V16H16V17C16,17.6 16.4,18 17,18H18V5C18,4.4 18.4,4 19,4C19.6,4 20,4.4 20,5V6H22V5C22,3.3 20.7,2 19,2Z

$mol_icon_script_text $mol_icon path \M17.8,20C17.4,21.2 16.3,22 15,22H5C3.3,22 2,20.7 2,19V18H5L14.2,18C14.6,19.2 15.7,20 17,20H17.8M19,2C20.7,2 22,3.3 22,5V6H20V5C20,4.4 19.6,4 19,4C18.4,4 18,4.4 18,5V18H17C16.4,18 16,17.6 16,17V16H5V5C5,3.3 6.3,2 8,2H19M8,6V8H15V6H8M8,10V12H14V10H8Z

$mol_link_source $mol_link
	hint @ \Source code
	sub /
		<= Icon $mol_icon_script_text

$mol_icon_check $mol_icon path \M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z

$bog_smalljs_top $mol_view
	Theme null
	github_uri \https://github.com/hyoo-ru/mam_mol
	logo_uri \bog/smalljs/assets/logo.svg
	search_click? null
	nav_pick? null
	sub /
		<= Logo $mol_link
			arg *
				section null
				page null
			sub /
				<= Logo_image $mol_image
					uri <= logo_uri
					title @ \smalljs
				<= Logo_text_box $mol_view
					sub /
						<= Logo_text \$mol
		<= Search $mol_button_minor
			click? <=> search_click?
			sub /
				<= Search_icon $mol_icon_magnify
				<= Search_label $mol_view
					sub /
						<= Search_label_text @ \Search
				<= Search_hint $mol_view
					sub /
						<= Search_hint_text @ \⌘ K
		<= Nav $mol_view
			sub /
				<= Docs_pick $mol_pick
					hint @ \Docs
					align \bottom_left
					trigger_content /
						<= Docs_label @ \Docs
						<= Docs_chevron $mol_icon_chevron_down
					bubble_content /
						<= Docs_menu $mol_view
							sub /
								<= Docs_quickstart $mol_link
									title @ \Quick Start
									arg *
										section \docs
										page \getting-started
									event_click? <=> nav_pick?
								<= Docs_guide $mol_link
									title @ \Guide
									arg *
										section \docs
										page \views
									event_click? <=> nav_pick?
								<= Docs_tutorial $bog_smalljs_top_item
									title @ \Tutorial
									arg *
										section \course
										page null
									event_click? <=> nav_pick?
								<= Docs_examples $mol_link
									title @ \Examples
									arg *
										section \docs
										page \showcase
									event_click? <=> nav_pick?
								<= Docs_api $mol_link
									title @ \API
									arg *
										section \docs
										page \api-mol-string
									event_click? <=> nav_pick?
				<= Nav_playground $bog_smalljs_top_item
					title @ \Playground
					arg *
						section \playground
						page null
				<= Nav_versus $bog_smalljs_top_item
					title @ \Compare
					arg *
						section \versus
						page null
				<= Ecosystem_pick $mol_pick
					hint @ \Ecosystem
					align \bottom_left
					trigger_content /
						<= Ecosystem_label @ \Ecosystem
						<= Ecosystem_chevron $mol_icon_chevron_down
					bubble_content /
						<= Ecosystem_menu $mol_view
							sub /
								<= Eco_components $mol_link
									title @ \UI Components
									uri \https://mol.hyoo.ru/#!section=demos
									event_click? <=> nav_pick?
								<= Eco_libs_title $mol_view
									sub /
										<= Eco_libs_title_text @ \Official Libraries
								<= Eco_wire $mol_link
									title @ \$mol_wire
									uri \https://github.com/hyoo-ru/mam_mol/tree/master/wire
									event_click? <=> nav_pick?
								<= Eco_fetch $mol_link
									title @ \$mol_fetch
									uri \https://github.com/hyoo-ru/mam_mol/tree/master/fetch
									event_click? <=> nav_pick?
								<= Eco_compare $mol_link
									title @ \$mol_compare_deep
									uri \https://github.com/hyoo-ru/mam_mol/tree/master/compare/deep
									event_click? <=> nav_pick?
								<= Eco_router $mol_link
									title @ \$mol_state_arg
									uri \https://github.com/hyoo-ru/mam_mol/tree/master/state/arg
									event_click? <=> nav_pick?
								<= Eco_crowd $mol_link
									title @ \$hyoo_crowd
									uri \https://github.com/hyoo-ru/crowd.hyoo.ru
									event_click? <=> nav_pick?
								<= Eco_baza $mol_link
									title @ \Giper Baza
									uri \https://github.com/giper-dev/baza
									event_click? <=> nav_pick?
				<= About_pick $mol_pick
					hint @ \About
					align \bottom_left
					trigger_content /
						<= About_label @ \About
						<= About_chevron $mol_icon_chevron_down
					bubble_content /
						<= About_menu $mol_view
							sub /
								<= About_faq $mol_link
									title @ \FAQ
									arg *
										section \docs
										page \faq
									event_click? <=> nav_pick?
								<= About_team $mol_link
									title @ \Team
									arg *
										section \docs
										page \team
									event_click? <=> nav_pick?
								<= About_releases $mol_link
									title @ \Releases
									arg *
										section \docs
										page \releases
									event_click? <=> nav_pick?
								<= About_telegram $mol_link
									title @ \Telegram
									uri \https://t.me/giper_dev
									event_click? <=> nav_pick?
		<= Burger $mol_pick
			hint @ \Menu
			align \bottom_right
			trigger_content /
				<= Burger_icon $mol_icon_hamburger
			bubble_content /
				<= Mobile_menu $mol_view
					sub /
						<= Mobile_playground $bog_smalljs_top_item
							title @ \Playground
							arg *
								section \playground
								page null
							event_click? <=> nav_pick?
						<= Mobile_versus $bog_smalljs_top_item
							title @ \Compare
							arg *
								section \versus
								page null
							event_click? <=> nav_pick?
						<= Docs_group $mol_expander
							title @ \Docs
							content /
								<= M_docs_quickstart $mol_link
									title @ \Quick Start
									arg *
										section \docs
										page \getting-started
									event_click? <=> nav_pick?
								<= M_docs_guide $mol_link
									title @ \Guide
									arg *
										section \docs
										page \views
									event_click? <=> nav_pick?
								<= M_docs_tutorial $bog_smalljs_top_item
									title @ \Tutorial
									arg *
										section \course
										page null
									event_click? <=> nav_pick?
								<= M_docs_examples $mol_link
									title @ \Examples
									arg *
										section \docs
										page \showcase
									event_click? <=> nav_pick?
								<= M_docs_api $mol_link
									title @ \API
									arg *
										section \docs
										page \api-mol-string
									event_click? <=> nav_pick?
						<= Ecosystem_group $mol_expander
							title @ \Ecosystem
							content /
								<= M_eco_components $mol_link
									title @ \UI Components
									uri \https://mol.hyoo.ru/#!section=demos
									event_click? <=> nav_pick?
								<= M_eco_libs_title $mol_view
									sub /
										<= M_eco_libs_title_text @ \Official Libraries
								<= M_eco_wire $mol_link
									title @ \$mol_wire
									uri \https://github.com/hyoo-ru/mam_mol/tree/master/wire
									event_click? <=> nav_pick?
								<= M_eco_fetch $mol_link
									title @ \$mol_fetch
									uri \https://github.com/hyoo-ru/mam_mol/tree/master/fetch
									event_click? <=> nav_pick?
								<= M_eco_compare $mol_link
									title @ \$mol_compare_deep
									uri \https://github.com/hyoo-ru/mam_mol/tree/master/compare/deep
									event_click? <=> nav_pick?
								<= M_eco_router $mol_link
									title @ \$mol_state_arg
									uri \https://github.com/hyoo-ru/mam_mol/tree/master/state/arg
									event_click? <=> nav_pick?
								<= M_eco_crowd $mol_link
									title @ \$hyoo_crowd
									uri \https://github.com/hyoo-ru/crowd.hyoo.ru
									event_click? <=> nav_pick?
								<= M_eco_baza $mol_link
									title @ \Giper Baza
									uri \https://github.com/giper-dev/baza
									event_click? <=> nav_pick?
						<= About_group $mol_expander
							title @ \About
							content /
								<= M_about_faq $mol_link
									title @ \FAQ
									arg *
										section \docs
										page \faq
									event_click? <=> nav_pick?
								<= M_about_team $mol_link
									title @ \Team
									arg *
										section \docs
										page \team
									event_click? <=> nav_pick?
								<= M_about_releases $mol_link
									title @ \Releases
									arg *
										section \docs
										page \releases
									event_click? <=> nav_pick?
								<= M_about_telegram $mol_link
									title @ \Telegram
									uri \https://t.me/giper_dev
									event_click? <=> nav_pick?
		<= Lang_pick $mol_pick
			hint @ \Language
			align \bottom_right
			trigger_content /
				<= Lang_icon $mol_icon_translate
				<= lang_label \EN
				<= Lang_chevron $mol_icon_chevron_down
			bubble_content /
				<= Lang_menu $mol_view
					sub <= lang_options /
		<= Theme_toggle $bog_theme_switch
			theme_auto <= Theme
		<= Github $mol_link_source
			uri <= github_uri
	Lang_option* $mol_button_minor
		sub /
			<= lang_option_label* \
			<= Lang_option_check* $mol_icon_check

$bog_smalljs_top_item $mol_link
	uri_off <= uri

$mol_hotkey $mol_plugin
	event *
		^
		keydown? <=> keydown? null
	key *
	mod_ctrl false
	mod_alt false
	mod_shift false

$mol_string $mol_view
	dom_name \input
	enabled true
	minimal_height 40
	autocomplete false
	selection? /number
		0
		0
	auto /
		<= selection_watcher null
		<= error_report null
	field *
		^
		disabled <= disabled false
		value <= value_changed? <=> value? \
		placeholder <= hint_visible <= hint \
		spellcheck <= spellcheck true
		autocomplete <= autocomplete_native \
		selectionEnd <= selection_end 0
		selectionStart <= selection_start 0
		inputMode <= keyboard \text
		enterkeyhint <= enter \go
	attr *
		^
		maxlength <= length_max +Infinity
		type <= type? \text
	event *
		^
		input? <=> event_change? null
	plugins /
		<= Submit $mol_hotkey
			mod_ctrl <= submit_with_ctrl false
			key * enter? <=> submit? null

$bog_smalljs_search $mol_view
	open? false
	query? \
	anchor_key \
	close? null
	focus? null
	activate? null
	select_next? null
	select_prev? null
	pick*? null
	attr *
		bog_smalljs_search_open <= open
	plugins /$mol_plugin
		<= Escape $mol_hotkey
			key * escape? <=> close?
		<= Nav_down $mol_hotkey
			key * down? <=> select_next?
		<= Nav_up $mol_hotkey
			key * up? <=> select_prev?
	sub /
		<= Backdrop $mol_view
			event *
				click? <=> close?
		<= Panel $mol_view
			sub /
				<= Field $mol_string
					value? <=> query?
					hint @ \Search the documentation…
					submit? <=> activate?
				<= Hint $mol_view
					sub / <= hint_text
				<= Results $mol_list
					rows <= result_rows /
	Result* $mol_link
		arg <= result_arg* *
		event_click? <=> pick*?
		attr *
			^
			bog_smalljs_search_current <= result_current* false
		sub /
			<= Result_title* $mol_view
				sub / <= result_title* \
			<= Result_snippet* $mol_view
				sub / <= result_snippet* \

$mol_button_major $mol_button_minor
	theme \$mol_theme_base

