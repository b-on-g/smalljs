$bog_smalljs_landing $mol_view
	sub /
		<= Hero $mol_view
			sub /
				<= Hero_head $mol_view
					sub /
						<= Hero_eyebrow $mol_view
							sub /
								<= Hero_eyebrow_text @ \Reactive micromodules
						<= Hero_title $mol_view
							dom_name \h1
							sub /
								<= Hero_title_pre @ \$mol — the reactive
								<= Hero_title_accent $mol_view
									dom_name \span
									sub /
										<= Hero_title_accent_text @ \micromodule
								<= Hero_title_post @ \ framework
						<= Hero_subtitle $mol_view
							sub /
								<= Hero_subtitle_text @ \Reactivity lives in the framework's foundation, not bolted on top.
						<= Hero_subtitle_note $mol_view
							sub /
								<= Hero_subtitle_note_text @ \Dependency arrays, manual subscriptions, manual cache invalidation, effect cleanup — none of it exists here. Not made easier, made unnecessary.
						<= Hero_actions $mol_view
							sub /
								<= Hero_cta_start $mol_link
									arg *
										section \docs
